# ── Supabase (Project Settings → API) ──────────────────────────────
# Public keys — safe to expose in the browser (used by the SPA).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY

# ── Supabase service role ──────────────────────────────────────────
# Secret — used only inside Netlify Functions. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# ── Number Panel API ───────────────────────────────────────────────
# Your master key from https://numberpanel.tech → API Keys.
# If left empty, the key stored in the Supabase `settings` table is used instead.
NP_API_KEY=
NP_BASE_URL=https://numberpanel.tech
